{
  "name": "vixlens-ds",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist-lib/vixlens-ds.js",
  "module": "./dist-lib/vixlens-ds.js",
  "exports": {
    ".": "./dist-lib/vixlens-ds.js",
    "./theme.css": "./theme.css",
    "./tailwind.preset.js": "./tailwind.preset.js",
    "./tailwind.css": "./assets/tokens/vixlens-theme-v4.css",
    "./tokens": "./assets/tokens/vixlens-tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "theme.css",
    "tailwind.preset.js",
    "assets/tokens"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-tokens.mjs --check && node scripts/validate-skills.mjs",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "lint": "eslint .",
    "a11y": "npx --yes @lhci/cli autorun",
    "skills:check": "node scripts/validate-skills.mjs",
    "hooks:setup": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vite-plugin-static-copy": "^2.2.0",
    "yaml": "^2.9.0"
  }
}
